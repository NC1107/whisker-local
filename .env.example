# install.sh writes the real .env. This shows what ends up in it.
# ACCESS_KEY is left empty on purpose, install.sh generates one when it is empty.
LAN_IP=192.168.1.50
DASHBOARD_PORT=8420
ROBOT_SERIAL=LR4C123456
ACCESS_KEY=
HOST_UID=1000
HOST_GID=1000

# Optional. Leave empty for no push notifications at all. Must be https.
# PUSH_RELAY_URL=https://relay.example.com
